# Copy this file to `.env` and adjust as needed.
# Run with:  node --env-file=.env src/server.js
# (Plain `npm start` also works and falls back to the defaults below.)

# HTTP port the API + frontend are served on
PORT=3000

# Comma separated list of allowed browser origins.
# Use * to allow any origin (handy while developing a separately served frontend).
CORS_ORIGIN=*

# Stock level at or below which an item is flagged as "Low Stock" (0 disables the label)
LOW_STOCK_THRESHOLD=5

# Load the demo dataset from the assignment on startup (true|false)
SEED_DATA=true

# morgan log format: dev | combined | tiny | off
LOG_FORMAT=dev

# ---------------------------------------------------------------------------
# MySQL connection (Mode B).
# The current build uses the in-memory store; these values are read once the
# data layer is pointed at MySQL (see README "Swapping in MySQL").
# When using a real database, set SEED_DATA=false above.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=item_purchase_db
